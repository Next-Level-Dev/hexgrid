# HexGrid Tactics environment configuration
# Copy this file to .env and adjust as needed. (.env is gitignored; this example is not.)

# Port the Express server listens on (default 3000)
PORT=3000

# "production" serves the built dist/ bundle and marks cookies secure;
# anything else runs the Vite dev server with HMR (default development)
NODE_ENV=development

# Set to "true" to disable Vite hot module reload during development
DISABLE_HMR=false

# Public base URL used by `npm run admin:link` when printing one-time
# admin auth links (defaults to http://localhost:3000)
APP_URL=http://localhost:3003
